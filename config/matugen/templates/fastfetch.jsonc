{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " ➜ ",
    "key": {
      "width": 18
    }
  },

  "modules": [
    {
      "type": "title"
    },
    "separator",

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m╭────────────────────────────────── SYSTEM ──────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m╰────────────────────────────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m╭───────────────────────────────── DESKTOP ──────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "de",
      "key": "󰘔 DE",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "wm",
      "key": "󰖲 WM",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "wmtheme",
      "key": "󰋜 WM Theme",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "theme",
      "key": "󰔎 Theme",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "font",
      "key": "󰛖 Font",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "cursor",
      "key": "󰇀 Cursor",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "terminalfont",
      "key": " Term Font",
      "keyColor": "{{colors.secondary.default.hex}}"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m╰────────────────────────────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m╭───────────────────────────────── HARDWARE ─────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "swap",
      "key": "󰾴 Swap",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m╰────────────────────────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "separator",

    {
      "type": "colors"
    }
  ]
}