  "editor.tokenColorCustomizations": {
    "comments": "#646B7E",
    "strings": "#C3E88D",
    "keywords": "#82AAFF",
    "numbers": "#F78C6C",
    "types": "#FFCB6B",
    "functions": "#7DCFFF",
    "variables": "#F2EFF2",
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic",
          "foreground": "#646B7E"
        }
      },
      {
        "scope": [
          "comment.line",
          "comment.block"
        ],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#646B7E"
        }
      },
      {
        "scope": "keyword.control",
        "settings": {
          "foreground": "#82AAFF",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "keyword.operator",
        "settings": {
          "foreground": "#89DDFF"
        }
      },
      {
        "scope": "storage",
        "settings": {
          "foreground": "#C792EA"
        }
      },
      {
        "scope": "storage.type",
        "settings": {
          "foreground": "#FFCB6B"
        }
      },
      {
        "scope": "string.quoted",
        "settings": {
          "foreground": "#C3E88D"
        }
      },
      {
        "scope": "string.template",
        "settings": {
          "foreground": "#C3E88D"
        }
      },
      {
        "scope": "string.regexp",
        "settings": {
          "foreground": "#7DCFFF"
        }
      },
      {
        "scope": "constant.numeric",
        "settings": {
          "foreground": "#F78C6C"
        }
      },
      {
        "scope": "constant.language",
        "settings": {
          "foreground": "#F78C6C"
        }
      },
      {
        "scope": "constant.character",
        "settings": {
          "foreground": "#F78C6C"
        }
      },
      {
        "scope": "entity.name.function",
        "settings": {
          "foreground": "#7DCFFF"
        }
      },
      {
        "scope": "entity.name.class",
        "settings": {
          "foreground": "#FFCB6B"
        }
      },
      {
        "scope": "entity.name.type",
        "settings": {
          "foreground": "#FFCB6B"
        }
      },
      {
        "scope": "entity.name.tag",
        "settings": {
          "foreground": "#F07178"
        }
      },
      {
        "scope": "entity.other.attribute-name",
        "settings": {
          "foreground": "#C792EA"
        }
      },
      {
        "scope": "variable",
        "settings": {
          "foreground": "#F2EFF2"
        }
      },
      {
        "scope": "variable.parameter",
        "settings": {
          "foreground": "#FFCB6B"
        }
      },
      {
        "scope": "variable.other.property",
        "settings": {
          "foreground": "#89DDFF"
        }
      },
      {
        "scope": "punctuation",
        "settings": {
          "foreground": "#89DDFF"
        }
      },
      {
        "scope": "punctuation.definition.tag",
        "settings": {
          "foreground": "#89DDFF"
        }
      },
      {
        "scope": "meta.tag",
        "settings": {
          "foreground": "#F07178"
        }
      },
      {
        "scope": "markup.heading",
        "settings": {
          "foreground": "#82AAFF",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "markup.bold",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "markup.italic",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "markup.inline.raw",
        "settings": {
          "foreground": "#C3E88D"
        }
      },
      {
        "scope": "markup.fenced_code",
        "settings": {
          "foreground": "#F2EFF2"
        }
      }
    ]
  },
