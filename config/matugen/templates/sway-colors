# ── matugen-generated sway colors (Void port) — DO NOT EDIT ──
# Generated from the active wallpaper on every switch (sway-wall.sh).
set $m_primary {{colors.primary.default.hex}}
set $m_on_primary {{colors.on_primary.default.hex}}
set $m_primary_container {{colors.primary_container.default.hex}}
set $m_secondary {{colors.secondary.default.hex}}
set $m_tertiary {{colors.tertiary.default.hex}}
set $m_error {{colors.error.default.hex}}
set $m_background {{colors.background.default.hex}}
set $m_on_background {{colors.on_background.default.hex}}
set $m_surface {{colors.surface.default.hex}}
set $m_on_surface {{colors.on_surface.default.hex}}
set $m_surface_variant {{colors.surface_variant.default.hex}}
set $m_on_surface_variant {{colors.on_surface_variant.default.hex}}
set $m_surface_container {{colors.surface_container.default.hex}}
set $m_surface_container_high {{colors.surface_container_high.default.hex}}
set $m_outline {{colors.outline.default.hex}}

# Window decorations follow the wallpaper palette
client.focused          $m_primary $m_surface $m_on_surface $m_primary $m_primary
client.focused_inactive $m_surface_variant $m_surface $m_on_surface_variant $m_surface_variant $m_surface_variant
client.unfocused        $m_surface_variant $m_background $m_on_surface_variant $m_surface_variant $m_surface_variant
client.urgent           $m_error $m_background $m_on_surface $m_error $m_error
client.placeholder      $m_background $m_background $m_on_surface $m_background $m_background
client.background       $m_background
