# ──────────────────────────────────────────────────────────────
#   swayfx config — Void port of the Arch Hyprland (Lua) setup
#   Same keybinds ($mod = SUPER), same apps, same matugen theming.
#   See ~/.config/sway/scripts/ for the ported helpers.
#   Trailing `# <text>` comments feed the cheatsheet (Super+K).
# ──────────────────────────────────────────────────────────────

### Variables ###
set $mod Mod4
set $left h
set $up k
set $down j
set $right l
set $term alacritty
set $menu rofi -show drun -theme ~/.config/rofi/active-launcher.rasi
set $browser ~/.local/bin/helium-browser
set $editor alacritty -e nvim
set $file ~/.local/bin/thunar-cwd
set $swayscripts ~/.config/sway/scripts

# Wallpaper-driven colors (generated by matugen on every switch)
include ~/.config/sway/colors

### Outputs  (sway) ###
output eDP-1 mode 2880x1800@90Hz position 0,0 scale 2
# No `output * bg <image>` here on purpose: awww-daemon is the sole
# wallpaper painter. A sway image background spawns swaybg, which fights
# awww over the background layer — after any reload/reconfigure swaybg is
# recreated on top and hides awww, so Super+R recolors (matugen) while the
# picture looks frozen. With no bg directive there is no swaybg at all.

### Input  (sway) ###
input * {
    xkb_layout us
    repeat_delay 250
    repeat_rate 40
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    drag_lock enabled
}

### Cursor theme (Bibata-Modern-Ice @ 24px) ###
seat seat0 xcursor_theme Bibata-Modern-Ice 24

### Autostart  (sway) ###
exec dbus-update-activation-environment --all
# Single audio stack: clear orphans from unclean logouts, then start ONE
# pipewire — it auto-spawns wireplumber + pipewire-pulse via
# /etc/pipewire/pipewire.conf.d (10-wireplumber, 20-pipewire-pulse).
# Starting wireplumber manually as well creates a duplicate session
# manager and wedges PipeWire (no audio, pactl/wpctl hang).
exec sh -c "pkill -x pipewire-pulse; pkill -x wireplumber; pkill -x pipewire; sleep 1; exec pipewire"
# Card re-probes can come up muted (see snd-perms boot re-trigger): unmute
# the real default sink once it exists (volume itself is left untouched).
exec sh -c 'for i in $(seq 1 60); do s=$(pactl get-default-sink 2>/dev/null) || s=""; case "$s" in ""|*auto_null*|*Dummy*) sleep 1;; *) wpctl set-mute "$s" 0 >/dev/null 2>&1; break;; esac; done'
# Portal backends need PipeWire up (else the wlr backend exits at first
# activation and screen sharing stays down until retried): wait for the
# socket, then pre-start the wlr/gtk backends (see portal-warmup.sh).
exec $swayscripts/portal-warmup.sh
# Backlight persistence: kernel resets intel_backlight at boot; restore last saved value.
exec sh -c 'B=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/backlight" 2>/dev/null); case "$B" in ""|*[!0-9]*) ;; *) brightnessctl -c backlight set "$B" >/dev/null 2>&1 || true;; esac'
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec awww-daemon
exec $swayscripts/init-wallpaper.sh
exec swayidle -w -C ~/.config/sway/swayidle.conf
# Gated, single-instance waybar launch (see waybar-launch.sh): waits for a
# real default sink so the pulseaudio module never initializes hidden, and
# serializes with sway-wall.sh's fallback so boot never stacks two bars.
exec ~/.config/sway/scripts/waybar-launch.sh
exec sh -c "pgrep -x swayosd-server >/dev/null || exec swayosd-server"
exec mako
exec thunar --daemon 2>/dev/null # volume automount (replaces udiskie) + faster windows
# Removed: nm-applet / blueman-applet (floating-bar uses native
# custom/wifi + bluetooth modules; the tray applets duplicated them)
exec autotiling
exec sh -c "gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true"
exec sh -c "wl-paste --watch cliphist store"
exec ~/.local/bin/power-profiles watch
# Login terminal: alacritty is primary (foot kept as secondary fallback).
# Alacritty re-reads ~/.config/alacritty/colors.toml on every launch, so
# matugen re-themes apply to new windows without any daemon restart.
exec alacritty

### Look & feel  (sway) ###
font pango:JetBrainsMono Nerd Font 10
default_border pixel 2
default_floating_border pixel 2
titlebar_padding 10
titlebar_border_thickness 2
# Pure Wayland: never start Xwayland (no Xorg, no X11 backend).
xwayland disable
corner_radius 12
gaps inner 4
gaps outer 12
# Always draw borders, even with a single window visible (`on` hides the
# border on solo windows; `off` keeps the same 2px themed border as splits).
smart_borders off
smart_gaps off
# Blur off systemwide — transparency comes from app opacity (e.g. alacritty
# window.opacity / foot [colors-dark] alpha), not the blur pass. Tuning lines kept so blur can be
# re-enabled with one word if ever wanted.
blur disable
blur_xray enable
blur_passes 2
blur_radius 4
default_dim_inactive 0.12
shadows enable
shadow_blur_radius 8
shadow_color #00000028

floating_modifier $mod normal
mouse_warping container
focus_follows_mouse yes
workspace_layout default

# VS Code: whisper of transparency (Arch parity: code-translucent 0.92/0.88;
# sway takes a single value — active 0.92 wins, same as alacritty).
for_window [app_id="^(code|Code|code-oss)$"] opacity 0.92
# Floating popups: PDF (zathura) + image preview (imv) + archives
for_window [app_id="^org.pwmt.zathura$"] floating enable, resize set 1000 700, move position center
for_window [app_id="^imv"] floating enable, move position center
for_window [app_id="^xarchiver$"] floating enable, resize set 800 600, move position center
# Webapp installer/remover prompts (terminal wrappers): small centered float
for_window [app_id="^webapp-(install|remove)$"] floating enable, resize set 700 400, move position center
# FileChooser portal (Chromium upload/open): otherwise tiles fullscreen
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, resize set 900 650, move position center

# Lid close locks (ported from the Hyprland lid-switch bind)
bindswitch lid:on exec $swayscripts/lid-close.sh # Lock on lid close

