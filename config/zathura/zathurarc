# ── zathura — minimal PDF viewer (vim keys: j/k scroll, /=search, q=quit) ──
# Static light theme (NOT matugen-generated): wallpaper-tinted
# page/chrome colors hurt document readability, so this stays fixed.

set default-bg "#eeeeee"
set default-fg "#333333"

set statusbar-bg "#e0e0e0"
set statusbar-fg "#333333"

set inputbar-bg "#f5f5f5"
set inputbar-fg "#333333"

set notification-bg "#f5f5f5"
set notification-fg "#333333"
set notification-error-bg "#f5c6c6"
set notification-error-fg "#5c1a1a"
set notification-warning-bg "#f5e6c6"
set notification-warning-fg "#5c4a1a"

set completion-bg "#e0e0e0"
set completion-fg "#333333"
set completion-group-bg "#f5f5f5"
set completion-group-fg "#616161"
set completion-highlight-bg "#bdbdbd"
set completion-highlight-fg "#000000"

set index-bg "#eeeeee"
set index-fg "#333333"
set index-active-bg "#bdbdbd"
set index-active-fg "#000000"

set render-loading-bg "#eeeeee"
set render-loading-fg "#333333"

set highlight-color "#fff59d80"
set highlight-active-color "#ffcc8080"

set selection-clipboard clipboard
set scroll-step 50
set zoom-min 10
set zoom-max 1000
set pages-per-row 1
set first-page-column 1
set statusbar-home-tilde true
set window-title-basename true
set recolor false
set recolor-keephue true
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#212121"
set render-loading false

# toggle dark-page recolor
map R feedkeys ":set recolor!\<Return>"
