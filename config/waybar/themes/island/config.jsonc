{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 44,
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 100,
    "margin-right": 100,
    "modules-left": [
        "custom/launcher",
        "custom/record",
        "custom/voxtype",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "battery",
        "custom/power"
    ],
    // ── Modules ─────────────────────────────────
    "custom/launcher": {
        "format": "",
        "on-click": "rofi -show drun -theme ~/.config/rofi/theme.rasi",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month"
        }
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "kitty --class wiremix -e wiremix"
    },
    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/record": {
        "exec": "~/.config/waybar/scripts/recorder.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/recorder.sh toggle"
    },
    "custom/voxtype": {
        "exec": "~/.config/waybar/scripts/voxtype.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "voxtype record stop"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    }
}
