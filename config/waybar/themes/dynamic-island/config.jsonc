{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 34,
    "margin-top": 10,
    
    "modules-left": [
        "custom/record",
        "custom/voxtype"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/power"
    ],
    "modules-right": [
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "disable-scroll": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month"
        }
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "kitty --class wiremix -e wiremix"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂯",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/record": {
        "exec": "~/.config/waybar/scripts/recorder.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/recorder.sh toggle"
    },
    "custom/voxtype": {
        "exec": "~/.config/waybar/scripts/voxtype.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "voxtype record stop"
    }
}
