/* Picker menus (keybinds, notification history, herdr/tmux binds) —
 * applet base, centered and wider to read long rows.
 */
@import "~/.config/rofi/applet.rasi"

window {
    width:      700px;
    location:   center;
    anchor:     center;
    x-offset:   0;
    y-offset:   0;
}

listview {
    lines: 14;
}