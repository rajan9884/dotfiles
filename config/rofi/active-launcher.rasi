/* App launcher (drun / window) — applet base, centered and wider
 * with larger app icons.
 */
@import "~/.config/rofi/applet.rasi"

window {
    width:      560px;
    location:   center;
    anchor:     center;
    x-offset:   0;
    y-offset:   0;
}

entry {
    placeholder: "Search apps…";
}

listview {
    lines: 10;
}

element-icon {
    size: 32px;
}