config/waybar/config.jsonc
config/waybar/style.css

# Editor / IDE local state
config/nvim/lazy-lock.json
config/nvim/lazyvim.json

# cliamp playlists (runtime-generated from ~/Music folders by install.sh)
config/cliamp/playlists/

# Python bytecode (local syntax checks)
