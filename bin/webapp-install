#!/usr/bin/env bash

# nixos:summary=Create a desktop launcher for a web app
# nixos:args=[name url icon-url-or-name [custom-exec] [mime-types]]

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"

safe_icon_name() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

require_plain_name() {
  # The name becomes a filename. A slash would turn it into directory levels, so
  # the launcher lands somewhere webapp-remove cannot address and the app
  # is stuck in the launcher; a leading ../ leaves the applications directory
  # altogether. Refuse rather than silently renaming what the user typed -- most
  # often it is a URL entered in the name field.
  if [[ $1 == */* ]]; then
    echo "App name cannot contain '/': $1"
    exit 1
  fi
}

icon_name_from_ref() {
  local ref="$1"
  local name
  name=$(basename "$ref")

  if [[ $name == *.* ]]; then
    safe_icon_name "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

install_user_icon() {
  local source="$1"
  local name="$2"
  local dest="$ICON_DIR/$name.png"

  mkdir -p "$ICON_DIR"
  # Drop stale siblings first so a re-install with a different format wins.
  rm -f "${ICON_DIR}/${name}.webp" "${ICON_DIR}/${name}.jpg" "${ICON_DIR}/${name}.jpeg" "${ICON_DIR}/${name}.ico" "${ICON_DIR}/${name}.svg"
  if [[ $(file -b --mime-type "$source") == image/png ]]; then
    cp "$source" "$dest"
  elif command -v magick &>/dev/null && magick "$source" "png:$dest" 2>/dev/null; then
    :
  else
    local ext="${source##*.}"
    [[ $ext == "$source" ]] && ext="png"
    dest="$ICON_DIR/$name.$ext"
    cp "$source" "$dest"
  fi
  refresh_icon_cache
  printf '%s\n' "$dest"
}

ensure_hicolor_theme() {
  # gtk-update-icon-cache is a no-op without index.theme, leaving Icon=<name>
  # unresolvable for rofi/GIO. Seed the user hicolor theme once from system.
  local theme_dir="$HOME/.local/share/icons/hicolor"
  if [[ ! -f $theme_dir/index.theme && -f /usr/share/icons/hicolor/index.theme ]]; then
    mkdir -p "$theme_dir"
    cp /usr/share/icons/hicolor/index.theme "$theme_dir/index.theme"
  fi
}

refresh_icon_cache() {
  ensure_hicolor_theme
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
}

normalize_downloaded_icon() {
  # $1 = temp downloaded file, $2 = final .png dest. Icon theme lookups only
  # reliably resolve PNG/XPM/SVG, and loaders sniff content, so a WebP/JPEG
  # saved as .png shows as missing. Convert everything to a real PNG.
  local tmp="$1" dest="$2"
  local mime
  mime=$(file -b --mime-type "$tmp")
  if [[ $mime == image/png ]]; then
    mv -f "$tmp" "$dest"
    return 0
  fi
  if command -v magick &>/dev/null; then
    if magick "$tmp" "png:$dest" 2>/dev/null; then
      rm -f "$tmp"
      return 0
    fi
  fi
  rm -f "$tmp"
  return 1
}

download_icon() {
  local url="$1" dest="$2" tmp
  tmp=$(mktemp "${dest%/*}/.icon-download.XXXXXX") || return 1
  if ! curl -fsSL --max-time 10 -o "$tmp" "$url" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  [[ -s $tmp ]] || { rm -f "$tmp"; return 1; }
  [[ $(file -b --mime-type "$tmp") == image/* ]] || { rm -f "$tmp"; return 1; }
  # Drop stale siblings saved under a wrong extension by older installs.
  rm -f "${dest%.png}.webp" "${dest%.png}.jpg" "${dest%.png}.jpeg" "${dest%.png}.ico" "${dest%.png}.svg"
  normalize_downloaded_icon "$tmp" "$dest" && chmod 644 "$dest"
}

# Chromium --app= treats javascript:, file:, and data: as a document to
# run. Prefix schemeless input with https as before, then refuse anything
# that is not http(s).
normalize_webapp_url() {
  local url=$1
  if [[ ! $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi
  printf '%s' "$url"
}

# Raw whitespace must be percent-encoded in a URL. Refuse it before serializing
# the desktop entry; before Exec argument quoting, it also split browser flags
# and additional URLs into separate arguments. Schemes are case-insensitive.
require_http_url() {
  local url=$1

  if [[ $url =~ [[:space:]] ]]; then
    echo "Error: web app URL must not contain whitespace." >&2
    exit 1
  fi

  if [[ ! ${url,,} =~ ^https?:// ]]; then
    echo "Error: web app URL must be http or https." >&2
    exit 1
  fi
}

fetch_site_icon() {
  local site_url="$1" dest="$2"
  local origin page icon_url favicon_url
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  # Prefer the site's own high-res icon (apple-touch-icon is typically 180px+),
  # then any generic rel=icon link, then well-known paths, then third-party
  # services as a last resort. Some sites (e.g. x.com) advertise an
  # apple-touch-icon URL that returns HTML, which download_icon rejects via
  # the mime check, so every step must fall through to the next.
  # --compressed: without it some servers return gzip bytes (null bytes) which
  # bash command substitution drops with "ignored null byte in input".
  # tr -d '\0' + grep -a keep the parse working even on binary responses.
  page=$(curl -fsSL --compressed --max-time 5 "$site_url" 2>/dev/null | tr -d '\0' | head -c 100000 | tr '\n' ' ')
  icon_url=$(grep -aoiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
    grep -aoiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")
  favicon_url=$(grep -aoiE "<link[^>]*rel=[\"'](shortcut )?icon[\"'][^>]*>" <<<"$page" |
    grep -aoiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")

  resolve_icon_url() {
    case $1 in
    http://* | https://*) printf '%s' "$1" ;;
    //*) printf 'https:%s' "$1" ;;
    /*) printf '%s%s' "$origin" "$1" ;;
    ?*) printf '%s/%s' "$origin" "$1" ;;
    esac
  }

  { [[ -n $icon_url ]] && download_icon "$(resolve_icon_url "$icon_url")" "$dest"; } ||
    { [[ -n $favicon_url ]] && download_icon "$(resolve_icon_url "$favicon_url")" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    download_icon "$origin/favicon.ico" "$dest" ||
    download_icon "https://www.google.com/s2/favicons?domain=${site_url}&sz=256" "$dest" ||
    download_icon "https://icons.duckduckgo.com/ip3/${site_url#*://}.ico" "$dest"
}

desktop_string_escape() {
  # Desktop Entry "string" value (freedesktop Desktop Entry Spec, "Value types"):
  # a raw newline would start a new key line and let a value inject a second
  # Exec=. Escape backslash first, then tab/CR/LF and a leading space. Every value
  # written into the .desktop file passes through here.
  #
  # Parameter expansion rather than sed: GNU sed's N auto-prints the pattern space
  # and exits at end of input, so a `:a;N;$!ba` slurp skips every following s///
  # for a value with no newline in it - which is every value except the injection
  # attempt this exists to stop.
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  [[ $value == " "* ]] && value="\\s${value# }"

  printf '%s' "$value"
}

desktop_exec_arg() {
  # One Exec argument, double-quoted per the freedesktop Exec spec: inside quotes
  # " ` $ \ take a backslash and a literal % becomes %%. Only the default Exec's
  # URL needs this; $CUSTOM_EXEC stays a whole command line (file-syntax only).
  local escaped
  escaped=$(printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' -e 's/%/%%/g')
  printf '"%s"' "$escaped"
}

if (( $# < 3 )); then
  echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"
  APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
  require_plain_name "$APP_NAME"
  APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
  APP_URL=$(normalize_webapp_url "$APP_URL")
  require_http_url "$APP_URL"

  # Try to fetch the site's icon automatically first.
  mkdir -p "$ICON_DIR"
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  ICON_PATH=""
  if fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    refresh_icon_cache
    ICON_PATH="$ICON_DIR/$ICON_VALUE.png"
    ICON_REF="$ICON_VALUE"
  else
    ICON_REF=$(gum input --prompt "Icon URL/name> " --placeholder "Could not fetch favicon automatically. Enter PNG icon URL or icon name")
  fi

  CUSTOM_EXEC=""
  MIME_TYPES=""
  INTERACTIVE_MODE=true
else
  APP_NAME="$1"
  APP_URL=$(normalize_webapp_url "$2")
  require_http_url "$APP_URL"
  ICON_REF="$3"
  CUSTOM_EXEC="$4" # Optional custom exec command
  MIME_TYPES="$5"  # Optional mime types
  INTERACTIVE_MODE=false
fi

# Ensure valid execution
if [[ -z $APP_NAME || -z $APP_URL ]]; then
  echo "You must set app name and app URL!"
  exit 1
fi

require_plain_name "$APP_NAME"

# Interactive success already downloaded the icon above; skip the chain.
if [[ -z ${ICON_PATH:-} ]]; then
if [[ -z $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if ! fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "Error: Failed to download icon."
    exit 1
  fi
  refresh_icon_cache
  ICON_PATH="$ICON_DIR/$ICON_VALUE.png"
elif [[ $ICON_REF =~ ^https?:// ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if ! download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "Error: Failed to download icon."
    exit 1
  fi
  refresh_icon_cache
  ICON_PATH="$ICON_DIR/$ICON_VALUE.png"
elif [[ -f $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  ICON_PATH=$(install_user_icon "$ICON_REF" "$ICON_VALUE")
else
  # Bundled distro icons are package-owned under /usr/share/icons/hicolor.
  # Accept either "HEY" or the historical "HEY.png" argument form.
  ICON_VALUE=$(icon_name_from_ref "$ICON_REF")
  ICON_PATH=""
fi
fi

# Default Exec quotes the URL as one Exec-spec argument; the whole line then gets
# the file-syntax escaping below (unescaped first at read time per spec, so the
# layers compose). $CUSTOM_EXEC is a full command line, so it gets file-syntax only.
# Absolute launcher path: GUI launchers (rofi drun, GIO) inherit the systemd
# user PATH without ~/.local/bin, so a bare name fails with
# "Failed to execute child process". Resolve once at install time.
WEBAPP_LAUNCHER="$(command -v webapp-launch 2>/dev/null || printf '%s/.local/bin/webapp-launch' "$HOME")"
if [[ -n $CUSTOM_EXEC ]]; then
  EXEC_COMMAND=$CUSTOM_EXEC
else
  EXEC_COMMAND="$WEBAPP_LAUNCHER $(desktop_exec_arg "$APP_URL")"
fi

# Create application .desktop file
DESKTOP_DIR="$HOME/.local/share/applications"
DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

name_field=$(desktop_string_escape "$APP_NAME")
exec_field=$(desktop_string_escape "$EXEC_COMMAND")
# Absolute path: rofi uses Papirus-Dark, which ships its own generic `x` and
# `whatsapp` icons that shadow our hicolor theme-name icons. A file path
# bypasses theme lookup entirely so the downloaded brand icon always wins.
if [[ -n ${ICON_PATH:-} ]]; then
  icon_field=$(desktop_string_escape "$ICON_PATH")
else
  icon_field=$(desktop_string_escape "$ICON_VALUE")
fi

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$name_field
Comment=$name_field
Exec=$exec_field
Terminal=false
Type=Application
Icon=$icon_field
StartupNotify=true
EOF

# Add mime types if provided
if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$(desktop_string_escape "$MIME_TYPES")" >>"$DESKTOP_FILE"
fi

chmod +x "$DESKTOP_FILE"
update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
refresh_icon_cache

if [[ $INTERACTIVE_MODE == "true" ]]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
