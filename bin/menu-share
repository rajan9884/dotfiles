#!/usr/bin/env bash
# menu-share — share clipboard text or files to nearby devices.
# Omarchy parity (SUPER+CTRL+S): omarchy-menu-share uses localsend; here we
# use what this Arch already has (qrencode + python http, same kitty+gum
# pattern as wifi-share). If localsend is installed we prefer it.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:$PATH"

notify() { notify-send "Share" "$1" ${2:+-u "$2"} 2>/dev/null || true; }

lan_ip() {
  local dev
  dev=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  [[ -n ${dev:-} ]] || return 1
  ip -4 addr show dev "$dev" 2>/dev/null | awk '/inet / { sub(/\/.*/, "", $2); print $2; exit }'
}

show_qr() { # $1 = text, $2 = caption
  qrencode --type ANSIUTF8 --margin 2 --output - "$1"
  printf '\n%s\n' "$2"
}

share_clipboard() {
  local text tmp
  text=$(wl-paste 2>/dev/null || true)
  [[ -n $text ]] || { notify "Clipboard is empty" critical; return 1; }
  if command -v qrencode &>/dev/null && [[ ${#text} -lt 2000 ]]; then
    show_qr "$text" "Scan to grab the clipboard text (also kept in clipboard)"
  else
    tmp=$(mktemp --suffix=.txt)
    printf '%s' "$text" >"$tmp"
    serve_file "$tmp" "clipboard.txt"
  fi
}

serve_file() { # $1 = path, $2 = display name
  local ip port url
  ip=$(lan_ip) || { notify "No network connection" critical; return 1; }
  port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1])')
  url="http://$ip:$port/$(basename "$1")"
  printf 'Serving %s on %s\n\n' "$2" "$url"
  show_qr "$url" "Scan to download — keep this window open (Ctrl+C to stop)"
  python3 -m http.server "$port" --bind "$ip" --directory "$(dirname "$1")" >/dev/null 2>&1
}

serve_folder() { # $1 = dir path
  local ip port url
  ip=$(lan_ip) || { notify "No network connection" critical; return 1; }
  port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1])')
  url="http://$ip:$port/"
  printf 'Serving %s on %s\n\n' "$(basename "$1")" "$url"
  show_qr "$url" "Scan to browse — keep this window open (Ctrl+C to stop)"
  python3 -m http.server "$port" --bind "$ip" --directory "$1" >/dev/null 2>&1
}

share_file() {
  local picked
  picked=$(gum file --file --height 20 "$HOME" || true)
  [[ -n ${picked:-} && -f $picked ]] || return 1
  if command -v localsend &>/dev/null; then
    gum spin --spinner dot --title "Sending via localsend..." -- localsend --headless send "$picked"
    notify "Sent $(basename "$picked")"
  else
    serve_file "$picked" "$(basename "$picked")"
  fi
}

share_folder() {
  local picked
  picked=$(gum file --directory --height 20 "$HOME" || true)
  [[ -n ${picked:-} && -d $picked ]] || return 1
  if command -v localsend &>/dev/null; then
    gum spin --spinner dot --title "Sending via localsend..." -- localsend --headless send "$picked"
    notify "Sent $(basename "$picked")"
  else
    serve_folder "$picked"
  fi
}

mode=$(gum choose --header "Share" "Clipboard text" "File" "Folder" || true)
case "$mode" in
"Clipboard text") share_clipboard ;;
"File") share_file ;;
"Folder") share_folder ;;
*) exit 0 ;;
esac
