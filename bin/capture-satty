#!/usr/bin/env bash
# Region screenshot with annotation: captures via grim + slurp, opens the
# satty editor, saves to Pictures/Screenshots, copies result to clipboard.
# Used by `SUPER + SHIFT + S` (grim + slurp + satty required).
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

AREA=$(slurp 2>/dev/null) || exit 0
grim -g "$AREA" - 2>/dev/null | satty --filename - --output-filename "$FILE" --copy-command wl-copy

notify-send -t 4000 "Screenshot saved" "$FILE"
