#!/usr/bin/env bash
# menu-transcode — pick a picture/video, format and resolution, transcode it.
# Port of omarchy-transcode (ffmpeg/magick presets kept 1:1); the
# omarchy-menu-file/select UI is swapped for kitty+gum like the other menus.
# Usage: menu-transcode [--path dir] [input] [format] [resolution]
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:$PATH"

usage() {
  cat <<'EOF'
Usage:
  menu-transcode [--path path] [input] [format] [resolution]

With no input, pick a picture or video starting from a location you choose
(Home, Pictures, Videos, Downloads, current directory, or a custom path),
or only from --path when provided. Then pick the output format and resolution.

Resolutions:
  Pictures: high, medium, low
  Videos: 4k, 1080p, 720p
EOF
}

notify() { notify-send "Transcode" "$1" ${2:+-u "$2"} 2>/dev/null || true; }

media_type() {
  case "$(file -b --mime-type "$1")" in
  image/*) echo picture ;;
  video/*) echo video ;;
  *)
    echo "Unsupported file type" >&2
    return 1
    ;;
  esac
}

output_path() {
  printf '%s/%s-%s.%s' "$(dirname -- "$1")" "$(basename -- "$1" | sed 's/\.[^.]*$//')" "$3" "$2"
}

transcode_picture() { # input format resolution output
  local resize
  case "$3" in
  high) resize='3160x>' ;;
  medium) resize='2160x>' ;;
  low) resize='1080x>' ;;
  *) echo "Invalid picture resolution: $3" >&2; return 1 ;;
  esac
  case "$2" in
  jpg) magick "$1" -resize "$resize" -quality 85 -strip "$4" ;;
  png)
    magick "$1" -resize "$resize" -strip -define png:compression-filter=5 \
      -define png:compression-level=9 -define png:compression-strategy=1 \
      -define png:exclude-chunk=all "$4"
    ;;
  *) echo "Invalid picture format: $2" >&2; return 1 ;;
  esac
}

transcode_video() { # input format resolution output
  local scale
  case "$3" in
  4k) scale='scale=-2:2160' ;;
  1080p) scale='scale=-2:1080' ;;
  720p) scale='scale=-2:720' ;;
  *) echo "Invalid video resolution: $3" >&2; return 1 ;;
  esac
  case "$2" in
  mp4)
    if [[ $3 == "4k" ]]; then
      ffmpeg -hide_banner -loglevel warning -i "$1" -vf "$scale" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k -movflags +faststart "$4"
    else
      ffmpeg -hide_banner -loglevel warning -i "$1" -vf "$scale" -c:v libx264 -preset fast -crf 23 -c:a aac -b:a 192k -movflags +faststart "$4"
    fi
    ;;
  gif)
    ffmpeg -hide_banner -loglevel warning -i "$1" -vf "fps=10,$scale:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$4"
    ;;
  *) echo "Invalid video format: $2" >&2; return 1 ;;
  esac
}

main() {
  local input="" format="" resolution="" search_path="" type output positional=()
  while (($# > 0)); do
    case "$1" in
    --path)
      shift; (( $# > 0 )) || { echo "Missing value for --path" >&2; return 2; }
      search_path="$1" ;;
    --help | -h) usage; return 0 ;;
    --) shift; positional+=("$@"); break ;;
    --*) echo "Unknown option: $1" >&2; usage >&2; return 2 ;;
    *) positional+=("$1") ;;
    esac
    shift
  done
  input="${positional[0]:-}"; format="${positional[1]:-}"; resolution="${positional[2]:-}"
  search_path="${search_path:-$HOME/Pictures:$HOME/Videos}"

  if [[ -z $input ]]; then
    local root=""
    if [[ -n $search_path && -d $search_path ]]; then
      root="$search_path"
    else
      local location=""
      location=$(gum choose --header "Look in" "Home" "Pictures" "Videos" "Downloads" "Current directory" "Custom path..." || true)
      [[ -n ${location:-} ]] || return 1
      case "$location" in
      Home) root="$HOME" ;;
      Pictures) root="$HOME/Pictures" ;;
      Videos) root="$HOME/Videos" ;;
      Downloads) root="$HOME/Downloads" ;;
      "Current directory") root="$PWD" ;;
      "Custom path...")
        root=$(gum input --header "Folder" --placeholder "$HOME/Pictures" || true)
        ;;
      esac
    fi
    [[ -d ${root:-} ]] || root="$HOME"
    input=$(gum file --file --header "Pick a picture or video" --height 20 "$root" || true)
  fi
  [[ -n $input ]] || return 1
  [[ -f $input ]] || { echo "File not found: $input" >&2; return 1; }

  type=$(media_type "$input") || return 1
  if [[ $type == picture ]]; then
    [[ -n $format ]] || format=$(gum choose --header "Format" jpg png || true)
    [[ -n $resolution ]] || resolution=$(gum choose --header "Resolution" high medium low || true)
  else
    [[ -n $format ]] || format=$(gum choose --header "Format" mp4 gif || true)
    [[ -n $resolution ]] || resolution=$(gum choose --header "Resolution" 4k 1080p 720p || true)
  fi
  [[ -n ${format:-} && -n ${resolution:-} ]] || return 1

  output=$(output_path "$input" "$format" "$resolution")
  if [[ $type == picture ]]; then
    gum spin --spinner dot --title "Transcoding to $(basename "$output")..." -- bash -c 'transcode_picture "$@"' _ "$input" "$format" "$resolution" "$output"
  else
    gum spin --spinner dot --title "Transcoding to $(basename "$output")..." -- bash -c 'transcode_video "$@"' _ "$input" "$format" "$resolution" "$output"
  fi
  printf 'file://%s\n' "$(realpath -- "$output")" | wl-copy --type text/uri-list
  notify "Done: $(basename "$output") (path copied)"
  printf 'Done: %s\n' "$output"
}

# Export helpers so `gum spin -- bash -c` subshells can use them.
export -f transcode_picture transcode_video
main "$@"
