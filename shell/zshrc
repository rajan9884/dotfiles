# ~/.zshrc — Arch dotfiles (task-shell style).
#
# Guarded tool inits: a missing tool is skipped silently, so the shell always
# starts clean even mid-install (nothing here may error under `set -e`).
# Everything below matches the desktop's other shells.

# ── Aliases ──
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ff="fzf --preview 'bat --color=always {}'"
alias nix-clean='nix-collect-garbage -d && nix store optimise && du -sh /nix'

# Dual-GitHub helpers: git-work / git-personal / git-whoami
[ -f "$HOME/dotfiles/shell/git-accounts.sh" ] && source "$HOME/dotfiles/shell/git-accounts.sh"

# ── LS colours + completion colours ──
# Palette codes (0-15) not 256-index: they follow the matugen-theed
# terminal palette (ghostty/kitty map color4=primary, color6=tertiary_container).
export LS_COLORS="di=01;34:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:mi=00:su=37;41:sg=30;43:ca=00:tw=30;42:ow=34;42:st=37;44:ex=01;32"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Prompt (starship + matugen palette) ──
# ~/.config/starship.toml is generated by matugen on every wallpaper switch
# (templates/starship.toml → truecolor hex palette), so the prompt follows
# the desktop theme in every terminal — including Zed, whose Aura palette
# no longer affects it (no ANSI magenta/cyan, no powerline caps).
# bash inits starship too (see shell/bashrc).
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi




# ── Command history ──
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# ── Autosuggestions (up-arrow cycles suggestions) ──
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#777777'

# ── Tab completion (zsh-completions + compinit) ──
fpath=(/usr/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' verbose true

# ── Syntax highlighting (MUST be LAST plugin) ──
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ── Editor ──
export EDITOR="nvim" VISUAL="nvim"
export FZF_DEFAULT_OPTS="--height 90% --reverse --border"

# ── Speed tools (zoxide/fzf/yazi/atuin/direnv) ──
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init zsh --cmd z)"; fi
if [ -f /usr/share/fzf/key-bindings.zsh ]; then source /usr/share/fzf/key-bindings.zsh; fi
if [ -f /usr/share/fzf/completion.zsh ]; then source /usr/share/fzf/completion.zsh; fi
# Atuin owns Ctrl-R; fzf keeps Ctrl-T + Alt-C.
if command -v atuin >/dev/null 2>&1; then eval "$(atuin init zsh --disable-up-arrow)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook zsh)"; fi

# yazi: `y` cds into the directory you exit in
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  command yazi "$@" --cwd-file="$tmp"
  local cwd="$(cat -- "$tmp" 2>/dev/null)"
  rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd -- "$cwd"
}

# ~/.local/bin carries the repo helpers (arch-wallpaper-picker, …).
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH";; esac

# Desktop info on login
command -v fastfetch >/dev/null 2>&1 && fastfetch

# Added by Antigravity CLI installer
export PATH="/home/rj9884/.local/bin:$PATH"
export PATH=/home/rj9884/.opencode/bin:$PATH
